{
  "playwright.reuseBrowser": true,
  "playwright.showTrace": false,

  // Configuration for the official Cucumber extension
  "cucumber.features": [
    "features/**/*.feature"
  ],
  "cucumber.glue": [
    "steps/**/*.ts"
  ],

  // Specific internal Playwright BDD compilation bindings
  "playwrightBdd.configPath": "playwright.config.ts",
  "playwrightBdd.featureFolder": "features/ui",
  "playwrightBdd.stepsFolder": "steps"
}
